{
  "type": "immersive_brewing:infusion",
  "schema_version": 1,
  "adapter": "immersive_brewing:forge_registry",
  "input": {
    "item": "minecraft:potion",
    "match": "item"
  },
  "steps": [
    {
      "reagent": {
        "item": "minecraft:gunpowder"
      },
      "phase": "settle",
      "role": "container"
    }
  ],
  "expected_output": {
    "item": "minecraft:splash_potion",
    "potion": "same"
  },
  "batch": {
    "max_servings": 6,
    "servings_per_reagent": 3
  }
}
